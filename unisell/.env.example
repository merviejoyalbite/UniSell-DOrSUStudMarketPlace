# Copy this file to `.env` (or set the variable in your shell) when the app needs
# an explicit API address.
#
# Web preview (same machine as the API):
# EXPO_PUBLIC_API_URL=http://localhost:3001
#
# Physical phone (Expo Go): use the laptop's LAN IP, not localhost. On native the
# app swaps a loopback host for the Expo `hostUri` anyway, so localhost also works
# there as long as the API is running on the laptop.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3001
