    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api": "json-server --watch server/db.json --port 3001 --host 0.0.0.0 --static server/public",
    "db:reset": "node -e \"require('fs').copyFileSync('server/db.seed.json','server/db.json'); console.log('Restored server/db.json from server/db.seed.json.')\"",
    "photos": "node scripts/prepare-images.js",
    "seed-images": "node scripts/build-seed-images.js",
    "splash-icon": "node scripts/build-splash-icon.js",
    "app-icons": "node scripts/build-app-icons.js",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "build:preview": "npx eas-cli@latest build --platform android --profile preview"
  },
  "private": true
}
